// leetcode 35


class Solution {
public:
    int searchInsert(vector<int>& nums, int target) {
        int start = 0, end = nums.size() - 1;
        
        // Default insertion position if target is greater than all elements
        int index = nums.size(), mid;

        while(start <= end)
        {
            mid = start + (end - start) / 2;

            if(nums[mid] == target)
            {
                return mid;
            }
            else if(nums[mid] < target)
            {
                start = mid + 1;
            }
            else 
            {
                // Current mid is a possible insertion position
                index = mid;
                end = mid - 1;
            }
        }
        return index;
    }
};
