// leetcode 21

/*
    Problem: Merge Two Sorted Lists
    Platform: LeetCode
    Problem Number: 21

    Approach:
    - Use a dummy node to simplify the construction of the merged list.
    - Compare the values of both lists and attach the smaller node.
    - Append the remaining nodes after one list becomes empty.
    - Remove the dummy node and return the merged list.

    Time Complexity: O(m + n)
    Auxiliary Space Complexity: O(1)
*/

class Solution {
public:
    ListNode* mergeTwoLists(ListNode* list1, ListNode* list2) {

        // Dummy node helps simplify list construction
        ListNode* Head = new ListNode(0);
        ListNode* tail = Head;

        // Merge both lists in sorted order
        while(list1 && list2) {
            if(list1->val <= list2->val) {
                tail->next = list1;
                list1 = list1->next;
                tail = tail->next;
            }
            else {
                tail->next = list2;
                list2 = list2->next;
                tail = tail->next;
            }
        }

        // Attach the remaining nodes
        if(list1) {
            tail->next = list1;
        }
        else {
            tail->next = list2;
        }

        // Remove the dummy node
        tail = Head;
        Head = tail->next;
        delete tail;

        return Head;
    }
};
