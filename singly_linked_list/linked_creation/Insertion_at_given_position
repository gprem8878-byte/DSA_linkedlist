// Inserting the elements at the given of position of the list (linkedlist is already created here)
#include<iostream>
using namespace std;

class NODE{
   public:
   int data;
   NODE *next;
   NODE(int value){
       data = value;
       next = NULL;
   }
};
NODE *Create_Linked_list(int arr[],int index,int size){
    if(index == size){
        return NULL;
    }
    NODE *temp ;
    temp = new NODE(arr[index]);
    temp->next = Create_Linked_list(arr,index+1,size);
    return temp;
    // Time and space complexity is O(n )
}
