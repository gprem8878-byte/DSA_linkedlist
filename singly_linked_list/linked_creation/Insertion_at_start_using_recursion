#include<iostream>
using namespace std;

class NODE{
   public:
   int data;
   NODE *next;
   NODE(int value){
       data = value;
       next = NULL;
   }
};
NODE *Create_linked_list(int arr[],int index,int size,NODE* previous){
    if(index == size)
    return previous;
    NODE *temp;
    temp = new NODE(arr[index]);
    temp->next = previous;
    return Create_linked_list(arr,index+1,size,temp);
}
int main()
{
    NODE *Head;
    Head = NULL;
    int arr[5] = {2,3,5,7,8};
    Head = Create_linked_list(arr,0,5,Head);
    NODE *temp ;
    temp = Head;
    while(temp != NULL){ // we can write only temp here , it signifies that run the until the temp value exist
        cout << temp->data << " ";
        temp = temp->next;
    }
    NODE* current = Head;
    while (current != NULL) {
    NODE* nextNode = current->next;
    delete current;
    current = nextNode;
}
    return 0;
}
