#include<iostream>
using namespace std;

class NODE{
   public:
   int data;
   NODE *next;
   NODE(int value){
       data = value;
       next = NULL;
   }
};

NODE *Create_Linked_list(int arr[],int index,int size){
    if(index == size){
        return NULL;
    }
    NODE *temp ;
    temp = new NODE(arr[index]);
    temp->next = Create_Linked_list(arr,index+1,size);
    return temp;
    // Time and space complexity is O(n )
}
int main()
{
    NODE *Head,*tail;
    Head = NULL;
    int arr[5] = {2,3,5,7,8};
    
    Head = Create_Linked_list(arr,0,5);
    NODE *temp ;
    temp = Head;
    while(temp != NULL){ // we can write only temp here , it signifies that run the until the temp value exist
        cout << temp->data << " ";
        temp = temp->next;
    }
    return 0;
}
