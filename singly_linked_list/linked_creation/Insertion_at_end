    //         while(tail->next != NULL){
    //             tail = tail->next;
    //         }
    //         tail->next = new NODE(arr[i]);
    //     }
    // }
    for(int i=0;i<5;i++){
        if(Head == NULL){
            Head = new NODE(arr[i]);
            tail = Head;
        }
        else{
            tail->next = new NODE(arr[i]);
            tail = tail->next;
        }
    }

    NODE *temp ;
    temp = Head;
    while(temp != NULL){ // we can write only temp here , it signifies that run the until the temp value exist
        cout << temp->data << " ";
        temp = temp->next;
    }
    return 0;
}
