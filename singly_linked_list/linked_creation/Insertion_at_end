#include<iostream>
using namespace std;

class NODE{
   public:
   int data;
   NODE *next;
   NODE(int value){
       data = value;
       next = NULL;
   }
};

int main()
{
    NODE *Head,*tail;
    Head = NULL,tail = NULL;
    int arr[5] = {2,3,5,7,8}; 

    // for(int i=0;i<5;i++){
    //     if(Head == NULL){
    //         Head = new NODE(arr[i]);
    //     }
    //     else{ //Brute force approach
