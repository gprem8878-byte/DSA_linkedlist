    //Insert at the start of linkedlist
    NODE *head ;
    head = NULL;
    int arr[5] = {3,4,6,8,9};
    for(int i=0;i<5;i++){
    if(head == NULL){           // if linkedlist doesnt exist
        head = new NODE(arr[i]);
    }
    else{                    // if linked list already exist
        NODE * temp;
        temp = new NODE(arr[i]);
        temp->next = head;
        head = temp;
    }
}
    NODE *temp = head;
